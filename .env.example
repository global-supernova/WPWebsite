# Copy this file to `.env` and adjust as needed.
# The .env file is git-ignored so your local secrets stay out of the repo.

# Port the site is served on locally: http://localhost:${WP_PORT}
WP_PORT=8080

# Database credentials (used by both the db and wordpress services)
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress

# Set to 0 to disable WordPress debug mode
WORDPRESS_DEBUG=1
